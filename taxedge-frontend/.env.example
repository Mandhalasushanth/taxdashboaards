# API base path. Use a relative path (e.g. /api/v1) behind a reverse proxy so cookies stay same-origin,
# or an absolute URL when the backend lists this origin in taxedge.security.allowed-origins.
VITE_API_BASE_URL=/api/v1
VITE_NOTIFICATIONS_BASE_URL=/notifications

# Dev server only: backend origin the Vite proxy forwards VITE_API_BASE_URL to.
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_DEV_SERVER_PORT=5173

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Sign the user out after this many minutes without interaction (server timeout still applies).
VITE_SESSION_IDLE_TIMEOUT_MINUTES=30

# Branding shown in the UI and document title.
VITE_APP_NAME=TaxEdge
VITE_APP_TAGLINE=Fin Solutions

# Development only: sign in against in-browser demo accounts instead of the backend.
# Ignored by production builds (`vite build`), so demo credentials never ship.
VITE_ENABLE_DEMO_AUTH=false
